[Unit]
Description=Print SSH connection info to serial console
After=sshd.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'IP=$(hostname -I | awk "{print \$1}"); echo ""; echo "========================================"; echo " DEBUG SSH READY"; echo " ssh liveuser@${IP:-<no-ip>}  (password: live)"; echo " ssh root@${IP:-<no-ip>}      (password: root)"; echo "========================================"; echo ""'
StandardOutput=journal+console

[Install]
WantedBy=multi-user.target
