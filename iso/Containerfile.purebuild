# iso/Containerfile.purebuild — builds the purebuild static binary
# twice-removed from host Go: golang container compiles, scratch exports.
#
# Usage (invoked by Justfile):
#   podman build -f iso/Containerfile.purebuild \
#     --build-arg TACKLEBOX_SHA=<pinned> \
#     --output type=local,dest=.build/purebuild .
#
# Produces: .build/purebuild/purebuild (static, no cgo)
FROM docker.io/library/golang:1.26-bookworm@sha256:02f9f70beba7aa222cc739ab3935d1d948b80d154159ae00e885811d11d443bf AS build
ARG TACKLEBOX_SHA
RUN git clone --depth 1 https://github.com/tuna-os/tacklebox.git /src \
    && cd /src && git -c advice.detachedHead=false checkout "$TACKLEBOX_SHA"
WORKDIR /src
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/purebuild ./cmd/purebuild

FROM scratch
COPY --from=build /out/purebuild /purebuild
