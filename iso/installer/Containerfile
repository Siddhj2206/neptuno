# Offline installer ISO (doc/product.md): a small Anaconda environment built
# from fedora-bootc, with Neptuno embedded once as the payload by
#   image-builder --bootc-installer-payload-ref <PAYLOAD> generic-iso
# The ISO holds this installer's squashfs plus one copy of Neptuno in its
# containers-storage; nothing is pulled at install time.
#
# Adapted from osbuild's "Example Anaconda Installer Containerfile"
# (osbuild.org/docs/developer-guide/projects/image-builder/advanced/bootc/isos).
FROM quay.io/fedora/fedora-bootc:45@sha256:17227a17c0bb9222918881e27f254e219eb3808ceb4399e26322bbd2e77932bc

RUN dnf install -qy \
        anaconda \
        anaconda-install-img-deps \
        anaconda-dracut \
        dracut-config-generic \
        dracut-network \
        net-tools \
        grub2-efi-x64-cdboot \
        shim-x64 \
        plymouth \
        default-fonts-core-sans \
        default-fonts-other-sans \
        google-noto-sans-cjk-fonts \
        xorrisofs \
        squashfs-tools \
    && dnf clean all

RUN mkdir -p /boot/efi && cp -ra /usr/lib/efi/*/*/EFI /boot/efi

RUN mkdir -p /usr/lib/image-builder/bootc && cat <<'EOF' > /usr/lib/image-builder/bootc/iso.yaml
label: "Neptuno-Installer"
grub2:
  timeout: 5
  entries:
    - name: "Install Neptuno"
      linux: ${kernelpath} ${root} inst.graphical
      initrd: ${initrdpath}
EOF

# The live root is a small RAM overlay (about 20% of RAM), and bootc stages
# each image layer in /var/tmp while importing it. A 2 GB layer fails there with
# "no space left on device", so give /var/tmp its own tmpfs sized to RAM (it
# can spill to zram swap).
RUN echo "tmpfs /var/tmp tmpfs mode=1777,size=100%,nr_inodes=1m 0 0" >> /etc/fstab

# Anaconda's product name and release flag (pyanaconda/core/product.py). Without
# it the installer is "ANACONDA bluesky" and opens with a pre-release warning.
RUN printf '[Main]\nProduct=Neptuno\nVersion=45\nIsFinal=True\nBugURL=https://github.com/siddhj2206/neptuno/issues\n' > /.buildstamp

# The image the ISO embeds and installs; it must match image-builder's
# --bootc-installer-payload-ref. It keeps its registry name, so it is also the
# ref `bootc upgrade` follows after install.
ARG PAYLOAD=ghcr.io/siddhj2206/neptuno:latest
COPY interactive-defaults.ks /usr/share/anaconda/interactive-defaults.ks
RUN sed -i "s|@PAYLOAD@|${PAYLOAD}|g" /usr/share/anaconda/interactive-defaults.ks && \
    ! grep -q '@PAYLOAD@' /usr/share/anaconda/interactive-defaults.ks

# What lorax normally does so Anaconda runs: an `install` login that starts
# Anaconda, an empty root password, the repo dir moved, and the Anaconda target.
RUN echo "install:x:0:0:root:/root:/usr/libexec/anaconda/run-anaconda" >> /etc/passwd && \
    echo "install::14438:0:99999:7:::" >> /etc/shadow && \
    passwd -d root

RUN mv /usr/share/anaconda/list-harddrives-stub /usr/bin/list-harddrives && \
    mv /etc/yum.repos.d /etc/anaconda.repos.d && \
    ln -s /lib/systemd/system/anaconda.target /etc/systemd/system/default.target && \
    rm -v /usr/lib/systemd/system-generators/systemd-gpt-auto-generator

RUN ln -s /usr/lib/systemd/system/anaconda-shell@.service /usr/lib/systemd/system/autovt@.service

RUN mkdir -p /usr/lib/systemd/logind.conf.d && \
    printf '[Login]\nReserveVT=2\n' > /usr/lib/systemd/logind.conf.d/anaconda-shell.conf

RUN mkdir "$(realpath /root)" && \
    kernel=$(kernel-install list --json pretty | jq -r '.[] | select(.has_kernel == true) | .version') && \
    DRACUT_NO_XATTR=1 dracut --force -v --zstd --reproducible --no-hostonly \
        --add "anaconda" \
        "/usr/lib/modules/${kernel}/initramfs.img" "${kernel}"

# Anaconda runs as root; let PipeWire start for it.
RUN for unit in pipewire.service pipewire.socket; do \
        mkdir -p "/etc/systemd/user/${unit}.d" && \
        printf '[Unit]\nConditionUser=\n' > "/etc/systemd/user/${unit}.d/allowroot.conf"; \
    done
