{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    ":enablePreCommit"
  ],
  "description": "Runs as the hosted Mend Renovate app. Automerge relies on the `required` status from build.yml, which builds, boots and tests the image on every pull request.",
  "platformAutomerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "schedule": [
    "* 0-6 * * 1"
  ],
  "prConcurrentLimit": 10,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Container images pinned in Justfile variables: export x := env(\"X\", \"image:tag@sha256:...\")",
      "managerFilePatterns": [
        "/^Justfile$/"
      ],
      "matchStrings": [
        "export\\s+\\w+\\s+:=\\s+env\\(\"[^\"]+\",\\s+\"(?<depName>[^\\s:@\"]+(?:/[^\\s:@\"]+)+):(?<currentValue>[^\\s@\"]+)@(?<currentDigest>sha256:[a-f0-9]+)\"\\)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Images pinned inline (registry/image:tag@sha256:...) in workflow steps and the neptuno justfile",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/",
        "/^system_files/.+/justfile$/"
      ],
      "matchStrings": [
        "\\s(?<depName>(?:docker\\.io|ghcr\\.io|quay\\.io)/[^\\s:@\"]+):(?<currentValue>[^\\s@\"]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Versions pinned in build scripts: `# renovate: datasource=... depName=...` above VAR=value (nx)",
      "managerFilePatterns": [
        "/^build/.+\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\n\\w+=(?<currentValue>[^\\s]+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Tool versions annotated with `# renovate: datasource=... depName=...` above an env var",
      "managerFilePatterns": [
        "/^\\.github/(workflows|actions)/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\n\\s+\\w+: \"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Group and automerge non-major updates once the build is green.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true
    },
    {
      "description": "The base image: digest bumps go in as soon as they pass, not on the weekly schedule.",
      "matchDepNames": [
        "quay.io/fedora-ostree-desktops/base-atomic"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "schedule": [
        "at any time"
      ]
    },
    {
      "description": "A Fedora major (base-atomic 45 -> 46) is a planned, manual change: `45` is also in the dated tags and the installer.",
      "matchDepNames": [
        "quay.io/fedora-ostree-desktops/base-atomic",
        "quay.io/fedora/fedora-bootc"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Build tooling images move together, weekly.",
      "matchDatasources": [
        "docker"
      ],
      "matchDepNames": [
        "!quay.io/fedora-ostree-desktops/base-atomic"
      ],
      "groupName": "build tooling images"
    },
    {
      "description": "GitHub Actions: one weekly PR, after a 3-day quarantine. Actions run with packages:write and the signing identity, so only first-party ones automerge.",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions",
      "minimumReleaseAge": "3 days"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "!actions/**",
        "!sigstore/**"
      ],
      "automerge": false
    },
    {
      "description": "Majors always wait for a human. Last matching rule wins, so keep this last.",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ]
}
