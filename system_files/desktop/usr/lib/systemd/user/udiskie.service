# udiskie ships no unit. Linked into niri.service.wants (desktop.toml), so it
# runs only in the niri session.
[Unit]
Description=udiskie removable media automounter
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/udiskie --no-tray
Restart=on-failure
RestartSec=3
