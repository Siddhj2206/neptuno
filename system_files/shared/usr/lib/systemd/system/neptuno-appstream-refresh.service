# Replaces flatpak-appstream-refresh.service at boot (17.3): appstream data only
# matters when an app store is opened.
[Unit]
Description=Refresh Flatpak appstream data
Wants=network-online.target
After=network-online.target
ConditionACPower=true

[Service]
Type=oneshot
ExecStart=/usr/bin/flatpak update --system --appstream
Nice=19
IOSchedulingClass=idle
CPUWeight=20
