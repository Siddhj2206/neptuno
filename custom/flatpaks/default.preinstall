# Default Flatpak applications for Neptuno (GNOME and Niri/DMS desktop)
# Installed on first boot by flatpak-preinstall (our own service unit).
# All entries verified on Flathub 2026-08-28 (see docs/research/niri-layer-design.md).
# Format: INI with [Flatpak Preinstall NAME] sections.

# --- browser ---------------------------------------------------------------
[Flatpak Preinstall org.mozilla.firefox]
Branch=stable

# --- GNOME apps (native rpm NOT required — good flatpak citizens) -----------
[Flatpak Preinstall org.gnome.TextEditor]
Branch=stable

[Flatpak Preinstall org.gnome.Calculator]
Branch=stable

[Flatpak Preinstall org.gnome.FileRoller]
Branch=stable

[Flatpak Preinstall org.gnome.Loupe]
Branch=stable

[Flatpak Preinstall org.gnome.Papers]
Branch=stable

[Flatpak Preinstall org.gnome.baobab]
Branch=stable

[Flatpak Preinstall org.gnome.Logs]
Branch=stable

[Flatpak Preinstall org.gnome.SimpleScan]
Branch=stable

[Flatpak Preinstall org.gnome.Snapshot]
Branch=stable

# --- utilities ---------------------------------------------------------------
[Flatpak Preinstall it.mijorus.smile]
Branch=stable

[Flatpak Preinstall io.github.flattool.Warehouse]
Branch=stable

[Flatpak Preinstall com.github.tchx84.Flatseal]
Branch=stable

[Flatpak Preinstall io.missioncenter.MissionCenter]
Branch=stable

# --- app store (bluefin/zirconium preinstall) --------------------------------
[Flatpak Preinstall io.github.kolunmi.Bazaar]
Branch=stable

# --- more GNOME set (ported from neptuno) ------------------------------------
[Flatpak Preinstall org.gnome.Calendar]
Branch=stable

[Flatpak Preinstall org.gnome.Weather]
Branch=stable

[Flatpak Preinstall org.gnome.Maps]
Branch=stable

[Flatpak Preinstall org.gnome.Firmware]
Branch=stable

[Flatpak Preinstall org.gnome.Showtime]
Branch=stable

[Flatpak Preinstall org.gnome.Decibels]
Branch=stable

# --- containers -----------------------------------------------------------------
[Flatpak Preinstall io.podman_desktop.PodmanDesktop]
Branch=stable

# --- host-proven picks (2026-08-29 audit vs neptuno host) ------------------------
[Flatpak Preinstall io.mpv.Mpv]
Branch=stable

[Flatpak Preinstall org.gnome.DejaDup]
Branch=stable

[Flatpak Preinstall app.zen_browser.zen]
Branch=stable

[Flatpak Preinstall it.mijorus.gearlever]
Branch=stable

# NOTE: org.gtk.Gtk3theme.adw-gtk3{-dark} are intentionally NOT preinstalled —
# they are MASKED (40-niri.sh) so the system theme (adw-gtk3 via gschema +
# xdg-data/themes override) always wins in flatpak apps.
