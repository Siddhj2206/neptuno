#!/usr/bin/python3
"""Read package sections from a packages TOML manifest.

Usage:
  read-packages <manifest.toml> <section> [field]   # print a list or string field, one per line
  read-packages <manifest.toml> --sections [prefix] # print section names (optionally prefixed)
  read-packages <manifest.toml> --wants             # print scope<TAB>target<TAB>unit

Exit codes:
  0 - ok
  1 - manifest unreadable / section missing / malformed
  2 - usage error
"""

import sys
import tomllib


def load_manifest(manifest_path: str) -> dict:
    with open(manifest_path, "rb") as manifest_file:
        return tomllib.load(manifest_file)


def main() -> int:
    if len(sys.argv) not in (3, 4):
        print(f"usage: {sys.argv[0]} <manifest.toml> <section> | --sections [prefix] | --wants",
              file=sys.stderr)
        return 2

    manifest_path = sys.argv[1]
    arg2 = sys.argv[2]

    try:
        manifest = load_manifest(manifest_path)
    except (OSError, tomllib.TOMLDecodeError) as error:
        print(f"error: cannot read {manifest_path}: {error}", file=sys.stderr)
        return 1

    if arg2 == "--sections":
        prefix = sys.argv[3] if len(sys.argv) == 4 else ""
        for section in manifest:
            if section.startswith(prefix):
                print(section)
        return 0

    if arg2 == "--wants":
        wants = manifest.get("wants", [])
        if not isinstance(wants, list):
            print("error: 'wants' must be an array of tables", file=sys.stderr)
            return 1
        for item in wants:
            if not isinstance(item, dict):
                print("error: every [[wants]] entry must be a table", file=sys.stderr)
                return 1
            scope = item.get("scope")
            target = item.get("target")
            units = item.get("units")
            if scope not in ("system", "user"):
                print(f"error: [[wants]] scope must be 'system' or 'user', got {scope!r}", file=sys.stderr)
                return 1
            if not isinstance(target, str) or not target:
                print("error: [[wants]] needs a non-empty target", file=sys.stderr)
                return 1
            if not isinstance(units, list) or not all(isinstance(unit, str) and unit for unit in units):
                print(f"error: [[wants]] {target} needs a units list of names", file=sys.stderr)
                return 1
            for unit in units:
                print(f"{scope}\t{target}\t{unit}")
        return 0

    if arg2 not in manifest:
        print(f"error: section '{arg2}' not found in {manifest_path}", file=sys.stderr)
        return 1

    field = sys.argv[3] if len(sys.argv) == 4 else "packages"
    entries = manifest[arg2].get(field)
    if isinstance(entries, str):
        print(entries)
        return 0
    if not isinstance(entries, list):
        print(f"error: section '{arg2}' has no '{field}' list or string", file=sys.stderr)
        return 1

    for entry in entries:
        print(entry)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
